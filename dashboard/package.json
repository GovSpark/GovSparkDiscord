{
  "name": "govspark-task-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.client.json --noEmit && vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply TASK_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply TASK_DB --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.120.0"
  }
}
