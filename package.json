{
  "name": "govspark-discord",
  "version": "1.0.0",
  "private": true,
  "description": "Discord voice-channel recording bot with Google Drive storage",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register-commands": "tsx src/register-commands.ts",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.18.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.5.0",
    "googleapis": "^174.0.1",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
