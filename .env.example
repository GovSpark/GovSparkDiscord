DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
RECORDING_RESULT_CHANNEL_NAME=recordings

# Cloudflare R2 S3-compatible credentials
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public r2.dev URL or custom domain, without the object key
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Render sets PORT automatically. This value is used for local execution.
PORT=10000

# Optional. ffmpeg must be on PATH when omitted.
FFMPEG_PATH=ffmpeg

# Optional task dashboard integration. Set both values to enable Discord DM reports.
TASK_API_BASE_URL=https://govspark-task-dashboard.<SUBDOMAIN>.workers.dev
TASK_API_SHARED_SECRET=
