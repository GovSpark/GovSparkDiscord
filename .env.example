DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
RECORDING_RESULT_CHANNEL_NAME=recordings

# Google Drive OAuth 2.0 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# The ID from the destination folder URL:
# https://drive.google.com/drive/folders/<GOOGLE_DRIVE_FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=

# Render sets PORT automatically. This value is used for local execution.
PORT=10000

# Optional. ffmpeg must be on PATH when omitted.
FFMPEG_PATH=ffmpeg
